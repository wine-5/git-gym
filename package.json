{
  "name": "git-gym",
  "productName": "Git Gym",
  "version": "0.1.1",
  "private": true,
  "description": "Git command practice app for beginners",
  "author": "YutoImata",
  "license": "MIT",
  "main": ".webpack/main",
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:icon": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').execSync('npx electron tools/icon/build.cjs',{stdio:'inherit'})\"",
    "fetch:git": "node tools/fetch-mingit.mjs"
  },
  "dependencies": {
    "devicon": "^2.17.0",
    "dockview-react": "^8.4.0",
    "lucide-react": "^1.49.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^6.11.0",
    "electron": "^42.11.10",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
