{
  // F5 で Git Gym を開発モードで起動する（webpack でビルドしてから Electron を立ち上げる）
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Git Gym を起動",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/@electron-forge/cli/dist/electron-forge-start.js",
      // Electron のメインプロセスを --inspect 付きで起動し、下の「メインプロセスにアタッチ」でデバッグできるようにする
      // （画面のデバッグは --remote-debugging-port に Chrome デバッガーでアタッチ）
      "args": ["--inspect-electron", "--", "--remote-debugging-port=9334"],
      // 子プロセス（webpack の開発サーバーや Electron）にまでデバッガーを自動で付けると起動が止まるので付けない
      "autoAttachChildProcesses": false,
      // VS Code から引き継ぐと Electron がただの Node として動いてしまうので消す
      "env": { "ELECTRON_RUN_AS_NODE": null },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "メインプロセスにアタッチ",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "timeout": 60000,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "画面にアタッチ（レンダラー）",
      "type": "chrome",
      "request": "attach",
      "port": 9334,
      "webRoot": "${workspaceFolder}",
      "timeout": 60000
    }
  ],
  "compounds": [
    {
      "name": "Git Gym を起動＋デバッグ（メイン・画面）",
      "configurations": ["Git Gym を起動", "メインプロセスにアタッチ", "画面にアタッチ（レンダラー）"],
      "stopAll": true
    }
  ]
}
